{
  "name": "xo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "dev:client": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "e2e": "playwright test",
    "xo": "node --env-file-if-exists=.env src/server/cli/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.11",
    "@preact/signals": "^2.11.4",
    "fastify": "^5.12.8",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
